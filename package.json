{
  "name": "platanus-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Visual IDE: your project as an isometric map, with an AI agent that builds and secures your code.",
  "author": "Platanus Hack 26 · team-12",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "vendor": "node scripts/vendor-ui.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "watch": "electron . --watch",
    "icons": "node scripts/build-icons.mjs",
    "build:web": "node scripts/build-web.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "test": "node --test electron/mcpServer.test.js electron/agentEvents.test.js electron/agentVoice.test.js electron/servers.test.js electron/git.test.js electron/approval.test.js electron/fileOpen.test.js electron/lineDiff.test.js electron/keyStore.test.js electron/opencode.test.js electron/agents.test.js scripts/sim/fakeAgent.test.js scripts/demo/path.test.mjs tests/renderer/*.test.mjs tests/secrets.test.mjs"
  },
  "build": {
    "appId": "us.platan.hack26.team12.ide",
    "productName": "Platanus",
    "icon": "project-logo.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "agent/**",
      "package.json"
    ],
    "artifactName": "Platanus-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Platanus usa la cámara solo si activas mover el mapa con la mano. La imagen no sale de tu computador."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@lezer/highlight": "^1.2.5",
    "@lobehub/icons-static-svg": "1.95.1",
    "border-beam": "^1.4.1",
    "codemirror": "^6.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "metal-fx": "^2.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "thinking-orbs": "^0.3.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "^0.160.0"
  }
}
